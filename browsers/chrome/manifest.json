{
  "manifest_version": 3,
  "name": "Omnigent web annotations",
  "version": "0.1.0",
  "description": "Pick visible page evidence for Omnigent.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "Pick page evidence"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Pick page evidence"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
