  "permissionCases": [
    {
      "name": "Cell wins",
      "master": {
        "*": {
          "*": {
            "permission": "manual"
          },
          "codex": {
            "permission": "approve-for-me"
          }
        },
        "desktop": {
          "*": {
            "permission": "read-only",
            "host_wins": true
          },
          "codex": {
            "permission": "full-access"
          }
        }
      },
      "harness": "codex",
      "host": "desktop",
      "expected": {
        "value": "full-access",
        "source": "master",
        "level": "cell"
      }
    },
    {
      "name": "Agent row wins",
      "master": {
        "*": {
          "*": {
            "permission": "manual"
          },
          "codex": {
            "permission": "approve-for-me"
          }
        },
        "desktop": {
          "*": {
            "permission": "read-only"
          }
        }
      },
      "harness": "codex",
      "host": "desktop",
      "expected": {
        "value": "approve-for-me",
        "source": "master",
        "level": "row"
      }
    },
    {
      "name": "Unmarked host follows row",
      "master": {
        "*": {
          "*": {
            "permission": "manual"
          }
        },
        "desktop": {
          "*": {
            "permission": "read-only"
          }
        }
      },
      "harness": "codex",
      "host": "desktop",
      "expected": {
        "value": "read-only",
        "source": "master",
        "level": "host"
      }
    },
    {
      "name": "Corner is last",
      "master": {
        "*": {
          "*": {
            "permission": "manual"
          }
        }
      },
      "harness": "codex",
      "host": "desktop",
      "expected": {
        "value": "ask-for-approval",
        "source": "master",
        "level": "corner"
      }
    },
    {
      "name": "Host wins beats row",
      "master": {
        "*": {
          "codex": {
            "permission": "approve-for-me"
          }
        },
        "desktop": {
          "*": {
            "permission": "read-only",
            "host_wins": true
          }
        }
      },
      "harness": "codex",
      "host": "desktop",
      "expected": {
        "value": "read-only",
        "source": "master",
        "level": "host"
      }
    },
    {
      "name": "Unsupported marked host skips",
      "master": {
        "*": {
          "codex": {
            "permission": "approve-for-me"
          }
        },
        "desktop": {
          "*": {
            "permission": "edit-automatic",
            "host_wins": true
          }
        }
      },
      "harness": "codex",
      "host": "desktop",
      "expected": {
        "value": "approve-for-me",
        "source": "master",
        "level": "row"
      }
    },
    {
      "name": "Unsafe corner is ignored",
      "master": {
        "*": {
          "*": {
            "permission": "full-access"
          }
        }
      },
      "harness": "codex",
      "host": "desktop",
      "expected": {
        "value": null,
        "source": "none",
        "level": null
      }
    },
    {
      "name": "Deny host is ignored",
      "master": {
        "*": {
          "codex": {
            "permission": "read-only"
          }
        },
        "desktop": {
          "*": {
            "permission": "deny",
            "host_wins": true
          }
        }
      },
      "harness": "codex",
      "host": "desktop",
      "expected": {
        "value": "read-only",
        "source": "master",
        "level": "row"
      }
    },
    {
      "name": "New host inherits agent row",
      "master": {
        "*": {
          "codex": {
            "permission": "approve-for-me"
          }
        }
      },
      "harness": "codex",
      "host": "new-host",
      "expected": {
        "value": "approve-for-me",
        "source": "master",
        "level": "row"
      }
    },
    {
      "name": "Invalid cell skips",
      "master": {
        "*": {
          "codex": {
            "permission": "ask-for-approval"
          }
        },
        "desktop": {
          "codex": {
            "permission": "obsolete"
          }
        }
      },
      "harness": "codex",
      "host": "desktop",
      "expected": {
        "value": "ask-for-approval",
        "source": "master",
        "level": "row"
      }
    },
    {
      "name": "Native fallback",
      "master": {
        "desktop": {
          "codex-native": {
            "permission": "read-only"
          }
        }
      },
      "harness": "codex",
      "host": "desktop",
      "expected": {
        "value": "read-only",
        "source": "master_native",
        "level": "cell"
      }
    },
    {
      "name": "Corner precedes native",
      "master": {
        "*": {
          "*": {
            "permission": "manual"
          }
        },
        "desktop": {
          "codex-native": {
            "permission": "read-only"
          }
        }
      },
      "harness": "codex",
      "host": "desktop",
      "expected": {
        "value": "ask-for-approval",
        "source": "master",
        "level": "corner"
      }
    },
    {
      "name": "Claude manual is a mode",
      "master": {
        "*": {
          "*": {
            "permission": "manual"
          }
        }
      },
      "harness": "claude-native",
      "host": "desktop",
      "expected": {
        "value": "default",
        "source": "master",
        "level": "corner"
      }
    },
    {
      "name": "Legacy tier stays normalized",
      "master": {
        "*": {
          "antigravity-native": {
            "permission": "auto-strict"
          }
        }
      },
      "harness": "antigravity-native",
      "host": "desktop",
      "expected": {
        "value": "auto",
        "source": "master",
        "level": "row"
      }
    },
    {
      "name": "Hermes cannot hold read only",
      "master": {
        "*": {
          "*": {
            "permission": "read-only"
          },
          "acp:example": {
            "permission": "dont_ask"
          }
        },
        "desktop": {
          "*": {
            "permission": "read-only",
            "host_wins": true
          }
        }
      },
      "harness": "acp:example",
      "host": "desktop",
      "expected": {
        "value": "dont_ask",
        "source": "master",
        "level": "row"
      },
      "permission_options": [
        {
          "value": "default",
          "label": "Ask for edits",
          "concept": "manual"
        },
        {
          "value": "accept_edits",
          "label": "Accept edits",
          "concept": "edit-automatic"
        },
        {
          "value": "dont_ask",
          "label": "Don't ask",
          "concept": "automatic"
        }
      ]
    }
