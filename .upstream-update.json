{
  "schema_version": 2,
  "branches": {
    "custom": "local/host-custom",
    "never_gc": [
      "local/host-custom",
      "merge/upstream-7a8846b26",
      "feature/manifest-identity-id",
      "feature/post-bind-hook",
      "feature/project-assignments",
      "fix/custom-realign-identity",
      "fix/custom-realign-py"
    ],
    "managed_backup_prefixes": [
      "backup/"
    ]
  },
  "worktree": {
    "tracked_dirty": "block",
    "untracked": "report",
    "incoming_collision": "block"
  },
  "verify": {
    "note": "argv are the justfile recipes' own commands, not `just` itself: just is not installed on every host that runs this (not on the Mac, checked 2026-09-18). Re-sync with the justfile when upstream changes a recipe.",
    "steps": [
      {
        "id": "lint-all",
        "cwd": ".",
        "argv": [
          "uv",
          "run",
          "--no-sync",
          "pre-commit",
          "run",
          "--all-files"
        ],
        "required": true,
        "timeout_s": 1800,
        "expect": "exit0",
        "note": "ruff format and prettier REWRITE files; a first-pass failure that the second pass clears is formatting drift, not a defect."
      },
      {
        "id": "typecheck-python",
        "cwd": ".",
        "argv": [
          "uv",
          "run",
          "--no-sync",
          "pyrefly",
          "check"
        ],
        "required": true,
        "timeout_s": 900,
        "expect": "exit0"
      },
      {
        "id": "ts-install",
        "cwd": ".",
        "argv": [
          "pnpm",
          "install",
          "--frozen-lockfile",
          "--filter",
          "web",
          "--filter",
          "omnigent-vscode"
        ],
        "required": true,
        "timeout_s": 1800,
        "expect": "exit0"
      },
      {
        "id": "lint-ts",
        "cwd": ".",
        "argv": [
          "pnpm",
          "--filter",
          "web",
          "run",
          "lint"
        ],
        "required": true,
        "timeout_s": 1800,
        "expect": "exit0"
      },
      {
        "id": "typecheck-ts",
        "cwd": ".",
        "argv": [
          "pnpm",
          "--filter",
          "web",
          "run",
          "type-check"
        ],
        "required": true,
        "timeout_s": 1800,
        "expect": "exit0"
      },
      {
        "id": "typecheck-vscode",
        "cwd": ".",
        "argv": [
          "pnpm",
          "--filter",
          "omnigent-vscode",
          "run",
          "type-check"
        ],
        "required": true,
        "timeout_s": 900,
        "expect": "exit0"
      },
      {
        "id": "pytest",
        "cwd": ".",
        "argv": [
          "uv",
          "run",
          "--no-sync",
          "pytest",
          "-q",
          "--ignore=tests/benchmarks",
          "--ignore=tests/test_subpackage_legal_files.py"
        ],
        "required": true,
        "timeout_s": 7200,
        "expect": "exit0",
        "note": "tests/benchmarks holds timed journeys that exceed the 90 s pytest-timeout and abort the whole run at item 29 of 26927; tests/test_subpackage_legal_files.py cannot import scripts.build_subpackages because scripts/ is not a package. Both conditions are present at the published head, not introduced by the custom line."
      }
    ]
  },
  "gc": {
    "enabled": false,
    "require_verified_merged": true,
    "require_head_oid_match": true
  },
  "deployment": {
    "executor": "human-only",
    "steps": [
      {
        "id": "release-custom",
        "run": "bash infra/server/gen-release.sh   # from the coordination root that holds this fork; full procedure in infra/server/RUNBOOK.md",
        "cwd": "..",
        "expected_observations": [
          "the release batch is approved by the user before any push, build or cutover",
          "content scan of origin/local/host-custom..local/host-custom is clean (scripts/custom-push-scan.sh)",
          "cutover prints CUTOVER_READY and COUNTS_PRESERVED; a migrating release also prints REHEARSAL_OK",
          "parity: host CLI version, fn container image revision label and the origin head of local/host-custom agree",
          "the released commit carries a release/<image-tag> tag pushed with that batch"
        ]
      }
    ]
  }
}
